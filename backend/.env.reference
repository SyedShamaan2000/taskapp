# Environment Variables Reference Template for Task Management App
# Copy this file to .env and fill in your values

# Server Configuration
PORT=3000
ALLOWED_ORIGINS=https://your-frontend-url.com, http://localhost:3000

# Database Configuration (MongoDB)
MONGODB_URL=mongodb+srv://username:password@cluster.mongodb.net/taskapp?retryWrites=true&w=majority

# Security (Optional)
JWT_SECRET=your-secret-key-here
NODE_ENV=development

# Additional Configuration
# API_KEY=your-api-key-here

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
EMAIL_FROM=Task App <your_email@gmail.com>
JWT_ACCESS_SECRET=taskapp-access-secret-prod-change-me
JWT_REFRESH_SECRET=taskapp-refresh-secret-prod-change-me
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d