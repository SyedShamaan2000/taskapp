# Environment Variables Reference Template for Task Management App
# Copy this file to .env and fill in your values

# Server Configuration
PORT=3000
ALLOWED_ORIGINS=https://your-frontend-url.com,http://localhost:3000
# Set to the number of trusted reverse-proxy hops in production (for example, 1).
TRUST_PROXY_HOPS=0

# Database Configuration (MongoDB)
MONGODB_URL=mongodb+srv://username:password@cluster.mongodb.net/taskapp?retryWrites=true&w=majority

# Security
NODE_ENV=development

# Additional Configuration
# API_KEY=your-api-key-here

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
EMAIL_FROM=Task App <your_email@gmail.com>
# Generate distinct random values for each secret; use at least 32 bytes.
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
CSRF_SECRET=replace-with-a-third-long-random-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d